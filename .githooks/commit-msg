#!/usr/bin/env bash
# Agent-agnostic commit-message gate (COMMIT-01). Enforces Conventional Commits
# on the subject line for ANYTHING that commits via git — Claude Code, Cursor,
# Codex, or a human. jq-free (bash+git only), offline-safe. Enabled by
# core.hooksPath=.githooks (install.sh). --no-verify bypass is banned (AGENTS.md §0).
#
# Format: type(scope)?!?: subject   ·   subject ≤ 72 chars (50 recommended)
# Blocked: unknown type, missing colon, empty/overlong subject.
# Exempt:  merge / revert / fixup! / squash! / comment / empty lines.

MSG_FILE="$1"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0   # nothing to check

# First non-comment, non-empty line is the subject.
subject=$(grep -vE '^[[:space:]]*#' "$MSG_FILE" 2>/dev/null | grep -vE '^[[:space:]]*$' | head -1)
[ -n "$subject" ] || exit 0   # empty message → let git handle it

# Exempt machine/auto formats.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Revert \""*) exit 0 ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

if ! printf '%s' "$subject" | grep -Eq "^(${TYPES})(\([a-z0-9._/-]+\))?!?: .+"; then
  echo "[commit-msg] Conventional Commits 위반 — 제목: \"$subject\"" >&2
  echo "  형식: <type>(scope)?: <subject>   type ∈ {${TYPES}}" >&2
  echo "  예: feat(auth): add JWT refresh   ·   fix: null guard on empty body" >&2
  exit 1
fi

# Subject length: 72 hard cap (git wrap limit). 50 is the recommended target.
if [ "${#subject}" -gt 72 ]; then
  echo "[commit-msg] 제목이 너무 김 (${#subject}자 > 72) — 72자 이하로 (권장 50)." >&2
  echo "  제목: \"$subject\"" >&2
  exit 1
fi

exit 0
