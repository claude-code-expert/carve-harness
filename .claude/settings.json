{
  "permissions": {
    "deny": ["Read(./**/.env)", "Read(./**/*secret*)", "Bash(rm -rf*)", "Bash(git push*--force*)"]
  },
  "hooks": {
    "PreToolUse":  [ { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "bash .claude/hooks/pretool-guard.sh" } ] } ],
    "PostToolUse": [ { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "bash .claude/hooks/posttool-format.sh" } ] } ],
    "Stop":        [ { "hooks": [ { "type": "command", "command": "bash .claude/hooks/stop-verify.sh" } ] } ],
    "SessionStart":[ { "hooks": [ { "type": "command", "command": "bash .claude/hooks/session-handoff.sh start" } ] } ],
    "PreCompact":  [ { "hooks": [ { "type": "command", "command": "bash .claude/hooks/session-handoff.sh save" } ] } ]
  }
}
